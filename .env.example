# Environment Variables for Collision Risk Assessment Backend
# Copy this file to .env and fill in your values

# Application
ENVIRONMENT=development          # development | testing | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_WORKERS=1

# TLE Data Source
NORAD_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=starlink&FORMAT=tle
TLE_CACHE_TTL=86400

# Database
DATABASE_URL=sqlite:///./data/collision_risk.db

# ML Models (MODEL_PATH concept; specific artifact paths)
MODEL_REGRESSOR_PATH=models/collision_msd_regressor.pkl
MODEL_CLASSIFIER_PATH=models/collision_risk_classifier.pkl
MODEL_SCALER_PATH=models/feature_scaler.pkl

# Batch processing
BATCH_SIZE=1000

# Cache
CACHE_TYPE=memory
CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=logs/collision_risk.log

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8501

# API Security (optional for MVP)
# API_KEY=your-secret-api-key-here

# Redis (if using distributed cache)
# REDIS_URL=redis://localhost:6379/0